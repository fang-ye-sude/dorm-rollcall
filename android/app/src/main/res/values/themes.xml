<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.DormRoll" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#D6E4F7</item>
        <item name="colorOnPrimaryContainer">#0B2B4D</item>
        <item name="colorSecondary">@color/gold</item>
        <item name="colorTertiary">@color/teal</item>
        <item name="colorError">@color/danger</item>
        <item name="android:colorBackground">@color/surface_bg</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="android:statusBarColor">@color/brand</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/surface_bg</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
    </style>

    <style name="Theme.DormRoll.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.DormRoll</item>
    </style>
</resources>
